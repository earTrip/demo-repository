# 이 파일을 .env로 복사하고 실제 값으로 채울 것.

# Supabase 프로젝트 생성 후 채울 것.
# anon key는 클라이언트에 노출되어도 되는 공개 키다 (RLS로 보호되는 게 원칙).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# 백엔드 주소 override. 안 넣으면 courseApi.js가 플랫폼별 기본값을 쓴다
# (안드로이드 에뮬레이터 http://10.0.2.2:8080, 웹·iOS 시뮬레이터 http://localhost:8080).
# 실기기로 붙을 때만 필요하다 — 기기에서 localhost/10.0.2.2는 기기 자신을 가리키므로
# 같은 와이파이에 있는 개발 PC의 LAN IP를 적을 것.
# EXPO_PUBLIC_API_BASE=http://192.168.0.10:8080

# Google Cloud Console에서 "Maps SDK for Android" 활성화 후 발급.
# app.config.js에서 android.config.googleMaps.apiKey로 빌드 시점에 주입됨 (런타임 비밀 아님, APK 안에 그대로 포함됨).
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY
